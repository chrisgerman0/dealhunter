# Deal Hunter env (optional)

# Listings source. mock (default) until PropertyData is keyed.
# DATA_SOURCE=mock
# DATA_SOURCE=propertydata
# rightmove / zoopla stubs throw — do not scrape those sites.
# PROPERTYDATA_API_KEY=
# PROPERTYDATA_LISTS=unmodernised-properties,reduced-properties

# Maps use MapLibre + Esri free tiles — no token required.

# --- R2R mode (Florida rent-to-rent) ---

# Long-term rental listings. Unset = mock catalogue (isMock: true on every
# card). Sign up at https://developers.rentcast.io — free tier is 50
# calls/mo (dev/test only), $74/mo for 1,000 calls. One call per market per
# day is cached hard against that free-tier ceiling; see
# src/lib/r2r/rentcast.ts.
# RENTCAST_API_KEY=

# Airbnb comps need no key — src/lib/r2r/airbnb-live.ts scrapes airbnb.com
# directly (read-only, Deal Hunter's own copy, does not touch nfstay-hq).


# --- Zillow / Realtor.com listing mirror ---

# EGRESS PROXY. This is the one credential that decides whether the mirror
# works at all. Measured 2026-11-04: Zillow returns HTTP 403 (PerimeterX) to
# every request from a datacenter IP, including real headless Chromium, and
# returns HTTP 200 with the full listing payload from a residential IP.
# Realtor.com additionally geo-blocks non-US IPs outright ("Not available in
# your region"). So a US residential proxy is required for both.
#
# Single-value form -- every vendor hands out exactly this shape:
# SCRAPE_PROXY_URL=http://user:pass@gate.vendor.com:7000
#
# Or the individual vars:
# SCRAPE_PROXY_HOST=
# SCRAPE_PROXY_PORT=
# SCRAPE_PROXY_USERNAME=
# SCRAPE_PROXY_PASSWORD=
# SCRAPE_PROXY_ROTATE_EVERY=0     # new upstream IP every N requests; 0 = never
# SCRAPE_PROXY_STICKY=false       # keep one upstream IP for the whole process

# DURABLE MIRROR. Without these the mirror is an in-memory Map inside one
# serverless instance, so mirrored listings are lost when it recycles and the
# counts appear to reset. Upstash Redis free tier is enough. Use the REST
# pair, not the redis:// connection string.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
