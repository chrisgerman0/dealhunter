# Deal Hunter env (optional)

# Listings source. mock (default) until PropertyData is keyed.
# DATA_SOURCE=mock
# DATA_SOURCE=propertydata
# rightmove / zoopla stubs throw — do not scrape those sites.
# PROPERTYDATA_API_KEY=
# PROPERTYDATA_LISTS=unmodernised-properties,reduced-properties

# Maps use MapLibre + Esri free tiles — no token required.

# --- R2R mode (Florida rent-to-rent) ---

# Long-term rental listings. Unset = mock catalogue (isMock: true on every
# card). Sign up at https://developers.rentcast.io — free tier is 50
# calls/mo (dev/test only), $74/mo for 1,000 calls. One call per market per
# day is cached hard against that free-tier ceiling; see
# src/lib/r2r/rentcast.ts.
# RENTCAST_API_KEY=

# Airbnb comps need no key — src/lib/r2r/airbnb-live.ts scrapes airbnb.com
# directly (read-only, Deal Hunter's own copy, does not touch nfstay-hq).

